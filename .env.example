# ═══════════════════════════════════════════════════════
#          NEXUS — Environment Configuration
# ═══════════════════════════════════════════════════════
# Copy to .env and fill in values.
#
# PRODUCTION CHECKLIST (all required for full production mode):
# ✅ DEPLOYER_PRIVATE_KEY         — wallet with sFUEL on SKALE
# ✅ GEMINI_API_KEY                — free from aistudio.google.com/apikey
# ✅ PAYMENT_WALLET_ADDRESS        — wallet to receive payments
# ✅ IDENTITY_REGISTRY_ADDRESS     — set after contract deploy
# ✅ REPUTATION_REGISTRY_ADDRESS   — set after contract deploy
# ✅ ESCROW_ADDRESS                — set after contract deploy
# ═══════════════════════════════════════════════════════

# ── AI Engine ─────────────────────────────────────────
# Get FREE key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Server ────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── SKALE Blockchain (Nebula Testnet — gasless) ───────
SKALE_RPC_URL=https://testnet.skalenodes.com/v1/giant-half-dual-testnet
SKALE_CHAIN_ID=974399131

# Private key of deployer wallet (needs sFUEL from sfuelstation.com)
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# ── Smart Contracts (set after: cd contracts && npx hardhat run scripts/deploy.ts --network skale-testnet) ──
IDENTITY_REGISTRY_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
ESCROW_ADDRESS=

# ── x402 Payment Protocol ────────────────────────────
FACILITATOR_URL=https://facilitator.x402.org
PAYMENT_WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS

# ── Client ────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_SKALE_RPC_URL=https://testnet.skalenodes.com/v1/giant-half-dual-testnet
VITE_SKALE_CHAIN_ID=974399131
